} - 2 \\mathbf{b})$, we will use the distributive property of the cross product:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a} - 2 \\mathbf{b}) = \\mathbf{c} \\times (3 \\mathbf{a}) - \\mathbf{c} \\times (2 \\mathbf{b}).\n\\]\n\nUsing the scalar multiplication property of the cross product, we have:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a}) = 3 (\\mathbf{c} \\times \\mathbf{a}) \\quad \\text{and} \\quad \\mathbf{c} \\times (2 \\mathbf{b}) = 2 (\\mathbf{c} \\times \\mathbf{b}).\n\\]\n\nGiven:\n\\[\n\\mathbf{a} \\times \\mathbf{c} = \\begin{pmatrix} 4 \\\\ 7 \\\\ 2 \\end{pmatrix},\n\\]\nwe know:\n\\[\n\\mathbf{c} \\times \\mathbf{a} = -(\\mathbf{a} \\times \\mathbf{c}) = -\\begin{pmatrix} 4 \\\\ 7 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} -4 \\\\ -7 \\\\ -2 \\end{pmatrix}.\n\\]\n\nAlso given:\n\\[\n\\mathbf{b} \\times \\mathbf{c} = \\begin{pmatrix} 1 \\\\ -7 \\\\ 18 \\end{pmatrix},\n\\]\nwe know:\n\\[\n\\mathbf{c} \\times \\mathbf{b} = -(\\mathbf{b} \\times \\mathbf{c}) = -\\begin{pmatrix} 1 \\\\ -7 \\\\ 18 \\end{pmatrix} = \\begin{pmatrix} -1 \\\\ 7 \\\\ -18 \\end{pmatrix}.\n\\]\n\nNow we substitute these into our expression:\n\n\\[\n3 (\\mathbf{c} \\times \\mathbf{a}) = 3 \\begin{pmatrix} -4 \\\\ -7 \\\\ -2 \\end{pmatrix} = \\begin{pmatrix} -12 \\\\ -21 \\\\ -6 \\end{pmatrix},\n\\]\n\n\\[\n2 (\\mathbf{c} \\times \\mathbf{b}) = 2 \\begin{pmatrix} -1 \\\\ 7 \\\\ -18 \\end{pmatrix} = \\begin{pmatrix} -2 \\\\ 14 \\\\ -36 \\end{pmatrix}.\n\\]\n\nThus:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a} - 2 \\mathbf{b}) = \\begin{pmatrix} -12 \\\\ -21 \\\\ -6 \\end{pmatrix} - \\begin{pmatrix} -2 \\\\ 14 \\\\ -36 \\end{pmatrix} = \\begin{pmatrix} -12 + 2 \\\\ -21 - 14 \\\\ -6 + 36 \\end{pmatrix} = \\begin{pmatrix} -10 \\\\ -35 \\\\ 30 \\end{pmatrix}.\n\\]\n\nTherefore, the final answer is:\n\n\\[\n\\boxed{\\begin{pmatrix} -10 \\\\ -35 \\\\ 30 \\end{pmatrix}}.\n\\]"},"grade":{"answer":"\\boxed{\\begin{pmatrix} -10 \\\\ -35 \\\\ 30 \\end{pmatrix}}","correct":true,"format":"boxed","parseable":true,"retains_student_answer":false},"graded_text":"To find $\\mathbf{c} \\times (3 \\mathbf{a} - 2 \\mathbf{b})$, we will use the distributive property of the cross product:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a} - 2 \\mathbf{b}) = \\mathbf{c} \\times (3 \\mathbf{a}) - \\mathbf{c} \\times (2 \\mathbf{b}).\n\\]\n\nUsing the scalar multiplication property of the cross product, we have:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a}) = 3 (\\mathbf{c} \\times \\mathbf{a}) \\quad \\text{and} \\quad \\mathbf{c} \\times (2 \\mathbf{b}) = 2 (\\mathbf{c} \\times \\mathbf{b}).\n\\]\n\nGiven:\n\\[\n\\mathbf{a} \\times \\mathbf{c} = \\begin{pmatrix} 4 \\\\ 7 \\\\ 2 \\end{pmatrix},\n\\]\nwe know:\n\\[\n\\mathbf{c} \\times \\mathbf{a} = -(\\mathbf{a} \\times \\mathbf{c}) = -\\begin{pmatrix} 4 \\\\ 7 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} -4 \\\\ -7 \\\\ -2 \\end{pmatrix}.\n\\]\n\nAlso given:\n\\[\n\\mathbf{b} \\times \\mathbf{c} = \\begin{pmatrix} 1 \\\\ -7 \\\\ 18 \\end{pmatrix},\n\\]\nwe know:\n\\[\n\\mathbf{c} \\times \\mathbf{b} = -(\\mathbf{b} \\times \\mathbf{c}) = -\\begin{pmatrix} 1 \\\\ -7 \\\\ 18 \\end{pmatrix} = \\begin{pmatrix} -1 \\\\ 7 \\\\ -18 \\end{pmatrix}.\n\\]\n\nNow we substitute these into our expression:\n\n\\[\n3 (\\mathbf{c} \\times \\mathbf{a}) = 3 \\begin{pmatrix} -4 \\\\ -7 \\\\ -2 \\end{pmatrix} = \\begin{pmatrix} -12 \\\\ -21 \\\\ -6 \\end{pmatrix},\n\\]\n\n\\[\n2 (\\mathbf{c} \\times \\mathbf{b}) = 2 \\begin{pmatrix} -1 \\\\ 7 \\\\ -18 \\end{pmatrix} = \\begin{pmatrix} -2 \\\\ 14 \\\\ -36 \\end{pmatrix}.\n\\]\n\nThus:\n\n\\[\n\\mathbf{c} \\times (3 \\mathbf{a} - 2 \\mathbf{b}) = \\begin{pmatrix} -12 \\\\ -21 \\\\ -6 \\end{pmatrix} - \\begin{pmatrix} -2 \\\\ 14 \\\\ -36 \\end{pmatrix} = \\begin{pmatrix} -12 + 2 \\\\ -21 - 14 \\\\ -6 + 36 \\end{pmatrix} = \\begin{pmatrix} -10 \\\\ -35 \\\\ 30 \\end{pmatrix}.\n\\]\n\nTherefore, the final answer is:\n\n\\[\n\\boxed{\\begin{pmatrix} -10 \\\\ -35 \\\\ 30 \\end{pmatrix}}.\n\\]","id":"precalculus:429"}
