} + 6)} = \\frac{401 \\cdot 6 + 401 \\cdot 6\\sqrt{6} - 2406\\sqrt{6} - 2406 \\cdot 6}{6 - 36}\n   \\]\n   \\[\n   n = \\frac{2406 + 2406\\sqrt{6} - 2406\\sqrt{6} - 14436}{-30} = \\frac{2406 - 14436}{-30} = \\frac{-12030}{-30} = 401\n   \\]\n\nThus, the integer \\( n \\) is \\(\\boxed{401}\\)."},"grade":{"answer":"\\boxed{401}","correct":true,"format":"boxed","parseable":true,"retains_student_answer":false},"graded_text":"To solve for \\( n \\) such that \\( f(n) = 6n - 2005 \\) given the functional equation \\( f(f(x)) = 6x - 2005 \\), we will proceed step by step.\n\n1. **Assume \\( f(n) = 6n - 2005 \\):**\n   \\[\n   f(f(n)) = f(6n - 2005)\n   \\]\n   According to the functional equation:\n   \\[\n   f(f(n)) = 6n - 2005\n   \\]\n   Therefore:\n   \\[\n   f(6n - 2005) = 6n - 2005\n   \\]\n\n2. **Analyze the fixed point:**\n   We have:\n   \\[\n   f(6n - 2005) = 6n - 2005\n   \\]\n   This suggests that \\( 6n - 2005 \\) is a fixed point of the function \\( f \\).\n\n3. **Check the form of \\( f(x) \\):**\n   Since \\( f(f(x)) = 6x - 2005 \\), we hypothesize that \\( f(x) \\) might be a linear function. Let:\n   \\[\n   f(x) = ax + b\n   \\]\n   Substitute \\( f(x) = ax + b \\) into the functional equation:\n   \\[\n   f(f(x)) = f(ax + b) = a(ax + b) + b = a^2x + ab + b\n   \\]\n   According to the given equation:\n   \\[\n   a^2x + ab + b = 6x - 2005\n   \\]\n   By comparing coefficients, we get:\n   \\[\n   a^2 = 6 \\quad \\text{and} \\quad ab + b = -2005\n   \\]\n\n4. **Solve for \\( a \\) and \\( b \\):**\n   From \\( a^2 = 6 \\), we have:\n   \\[\n   a = \\sqrt{6} \\quad \\text{or} \\quad a = -\\sqrt{6}\n   \\]\n   Substitute \\( a = \\sqrt{6} \\) into \\( ab + b = -2005 \\):\n   \\[\n   \\sqrt{6}b + b = -2005 \\implies b(\\sqrt{6} + 1) = -2005 \\implies b = \\frac{-2005}{\\sqrt{6} + 1}\n   \\]\n   Rationalize the denominator:\n   \\[\n   b = \\frac{-2005(\\sqrt{6} - 1)}{(\\sqrt{6} + 1)(\\sqrt{6} - 1)} = \\frac{-2005(\\sqrt{6} - 1)}{6 - 1} = \\frac{-2005(\\sqrt{6} - 1)}{5} = -401(\\sqrt{6} - 1)\n   \\]\n\n   Similarly, if \\( a = -\\sqrt{6} \\):\n   \\[\n   -\\sqrt{6}b + b = -2005 \\implies b(-\\sqrt{6} + 1) = -2005 \\implies b = \\frac{-2005}{1 - \\sqrt{6}}\n   \\]\n   Rationalize the denominator:\n   \\[\n   b = \\frac{-2005(1 + \\sqrt{6})}{(1 - \\sqrt{6})(1 + \\sqrt{6})} = \\frac{-2005(1 + \\sqrt{6})}{1 - 6} = \\frac{-2005(1 + \\sqrt{6})}{-5} = 401(1 + \\sqrt{6})\n   \\]\n\n5. **Determine \\( n \\):**\n   We need \\( f(n) = 6n - 2005 \\). Using \\( f(x) = \\sqrt{6}x - 401(\\sqrt{6} - 1) \\):\n   \\[\n   \\sqrt{6}n - 401(\\sqrt{6} - 1) = 6n - 2005\n   \\]\n   Simplify and solve for \\( n \\):\n   \\[\n   \\sqrt{6}n - 401\\sqrt{6} + 401 = 6n - 2005\n   \\]\n   \\[\n   \\sqrt{6}n - 6n = 401\\sqrt{6} - 2406\n   \\]\n   \\[\n   n(\\sqrt{6} - 6) = 401\\sqrt{6} - 2406\n   \\]\n   \\[\n   n = \\frac{401\\sqrt{6} - 2406}{\\sqrt{6} - 6}\n   \\]\n   Rationalize the denominator:\n   \\[\n   n = \\frac{(401\\sqrt{6} - 2406)(\\sqrt{6} + 6)}{(\\sqrt{6} - 6)(\\sqrt{6} + 6)} = \\frac{401 \\cdot 6 + 401 \\cdot 6\\sqrt{6} - 2406\\sqrt{6} - 2406 \\cdot 6}{6 - 36}\n   \\]\n   \\[\n   n = \\frac{2406 + 2406\\sqrt{6} - 2406\\sqrt{6} - 14436}{-30} = \\frac{2406 - 14436}{-30} = \\frac{-12030}{-30} = 401\n   \\]\n\nThus, the integer \\( n \\) is \\(\\boxed{401}\\).","id":"intermediate_algebra:569"}
